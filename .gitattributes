# H58 reasoning exports intentionally use RFC 4180 CRLF record endings; retain them and do not flag CR as trailing whitespace.
docs/downloads/*h58*reasoning.csv whitespace=cr-at-eol

# Preserve RFC 4180 review exports and verbatim historical Markdown.
evidence/*ctd5*.csv whitespace=cr-at-eol
docs/downloads/*ctd5*.csv whitespace=cr-at-eol
knowledge/archive/*.md whitespace=-blank-at-eol,-blank-at-eof
# H61 reasoning export uses RFC 4180 CRLF record endings, like the H58 and CTD5 exports.
docs/downloads/*h61*reasoning.csv whitespace=cr-at-eol
evidence/*h61*.csv whitespace=cr-at-eol
